# Copy to client/.env if needed. Everything prefixed VITE_ is bundled into the public JavaScript:
# NEVER put secrets here (no API secrets, no database URLs, no payment-provider secrets).

# Leave unset in development (Vite proxies /api to port 5000) AND on Vercel when vercel.json forwards /api to the API.
# Set it only if the browser should call the API on another domain directly, e.g. https://api.example.com/api/v1
# VITE_API_BASE_URL=
