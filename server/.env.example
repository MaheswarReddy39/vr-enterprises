# Copy this file to server/.env and fill in YOUR OWN values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# Allowed browser origin(s) for CORS. Comma-separate to allow more than one.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# A plain local mongod (mongodb://localhost:27017/vr_enterprises) or Atlas both work: no replica set is needed.
# Images are stored in this same database using GridFS, so no separate image service or credentials are needed.
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vr-enterprises?retryWrites=true&w=majority
MONGODB_URI=

# Auth secrets: REQUIRED (the API will not start without them). 32+ characters, different from each other.
# Generate each one separately:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# SameSite policy for the refresh-token cookie: lax (default), strict, or none.
# Use "none" only when the site and API are on different registrable domains (needs HTTPS).
COOKIE_SAME_SITE=lax

# Number of reverse proxies in front of the API in production: 1 on Render alone, 2 with the Vercel /api rewrite.
TRUST_PROXY_HOPS=1

# Business details are edited in Admin > Store settings (stored in MongoDB). There are no payment keys: the site takes no online payments.

# ---- WhatsApp notifications (official Meta WhatsApp Business Cloud API). Leave the first two empty to send nothing. ----
# Setup steps and the two message templates to get approved are in README.md ("WhatsApp notifications").
# The access token is a SECRET: only ever put it here or in your host's environment settings, never in code or chat.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# >>> ADD YOUR NUMBER HERE <<< The business WhatsApp number that receives new-booking alerts, e.g. 9XXXXXXXXX (Indian mobile,
# with or without +91). It must differ from the sending number. Left empty, the alert is saved as failed with a clear reason.
WHATSAPP_ADMIN_NUMBER=
# Names of the approved templates and their language code.
WHATSAPP_TEMPLATE_ADMIN=vr_new_booking_alert
WHATSAPP_TEMPLATE_CUSTOMER=vr_booking_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
# Optional: contact number shown inside the messages. Admin > Store settings phone is used first when set.
WHATSAPP_BUSINESS_CONTACT=